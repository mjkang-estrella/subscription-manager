{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": { "maxDuration": 300, "includeFiles": "extension/**" }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/extension/:path*", "destination": "/api/index" },
    { "source": "/((?!api/|extension/).*)", "destination": "/index.html" }
  ]
}
