# Never commit real values. Copy this file to .env.
PORT=3000
DATABASE_URL=
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
# OPENAI_API_KEY is accepted as a gateway-token fallback, never sent to api.openai.com.
OPENAI_API_KEY=
AI_MODEL=gpt-5-mini
KERNEL_API_KEY=
EXA_API_KEY=
# Public HTTPS origin for hosted controlled merchant pages and private calendar links.
# On Vercel, defaults to VERCEL_PROJECT_PRODUCTION_URL.
PUBLIC_APP_URL=

# Optional Gmail read-only OAuth integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# Set for HTTPS serving. Local HTTP development must leave this false.
COOKIE_SECURE=false
# Optional access gate for private shared previews. Use a long random value.
# Open /?preview=<value> once to establish the access cookie.
PREVIEW_ACCESS_TOKEN=
